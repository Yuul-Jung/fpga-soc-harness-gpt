{
  "schema_version": 1,
  "id": "smart_fan",
  "title": "Basys3 스마트 팬·모터 PWM 및 회전 펄스 계측",
  "summary": "100 MHz 동기 RTL로 8비트 PWM 및 1초 회전 펄스 계측을 구현하고, MicroBlaze V SoC에서는 AXI GPIO 제어/상태 채널로 연결하는 종합과제 설계. 현재 RTL/테스트벤치 실습 예제이며 완성된 Vivado Block Design이 아니다.",
  "board": "Digilent Basys3 (Artix-7), 100 MHz",
  "status": "independent RTL implemented; SoC integration pending",
  "modules": [
    {
      "id": "clock_reset",
      "name": "basys3_clock_reset",
      "inputs": [],
      "outputs": [
        "clk",
        "rst"
      ]
    },
    {
      "id": "cpu",
      "name": "microblaze_v",
      "inputs": [
        "clk",
        "reset"
      ],
      "outputs": [
        "m_axi"
      ]
    },
    {
      "id": "interconnect",
      "name": "axi_interconnect",
      "inputs": [
        "s_axi"
      ],
      "outputs": [
        "m_axi_ctrl",
        "m_axi_status"
      ]
    },
    {
      "id": "gpio_ctrl",
      "name": "axi_gpio_ctrl",
      "inputs": [
        "s_axi"
      ],
      "outputs": [
        "gpio_io_o"
      ]
    },
    {
      "id": "gpio_status",
      "name": "axi_gpio_status",
      "inputs": [
        "s_axi",
        "gpio_io_i"
      ],
      "outputs": []
    },
    {
      "id": "peripheral",
      "name": "smart_fan_peripheral",
      "inputs": [
        "clk",
        "rst",
        "duty",
        "enable",
        "tach_in"
      ],
      "outputs": [
        "pwm_out",
        "tach_pulses_per_sec"
      ]
    },
    {
      "id": "external",
      "name": "external_fan_interface",
      "inputs": [
        "pwm_in"
      ],
      "outputs": [
        "tach_out"
      ]
    }
  ],
  "connections": [
    {
      "from": "clock_reset.clk",
      "to": "cpu.clk",
      "note": "100 MHz 보드 클럭; 실제 연결은 Vivado Clock Wizard/Reset 구성에 따라 확인"
    },
    {
      "from": "clock_reset.rst",
      "to": "cpu.reset",
      "note": "리셋 극성은 CPU/RTL별 맞춤 필요"
    },
    {
      "from": "clock_reset.clk",
      "to": "peripheral.clk",
      "note": "단일 클럭 도메인"
    },
    {
      "from": "clock_reset.rst",
      "to": "peripheral.rst",
      "note": "동기 active-high reset"
    },
    {
      "from": "cpu.m_axi",
      "to": "interconnect.s_axi",
      "note": "AXI 연결 개념; CPU/Interconnect 구성 확인"
    },
    {
      "from": "interconnect.m_axi_ctrl",
      "to": "gpio_ctrl.s_axi",
      "note": "AXI GPIO 9-bit OUTPUT"
    },
    {
      "from": "interconnect.m_axi_status",
      "to": "gpio_status.s_axi",
      "note": "AXI GPIO 32-bit INPUT"
    },
    {
      "from": "gpio_ctrl.gpio_io_o",
      "to": "peripheral.duty",
      "note": "gpio_io_o[7:0] → duty[7:0]; Top 비트 선택만 사용"
    },
    {
      "from": "gpio_ctrl.gpio_io_o",
      "to": "peripheral.enable",
      "note": "gpio_io_o[8] → enable"
    },
    {
      "from": "peripheral.tach_pulses_per_sec",
      "to": "gpio_status.gpio_io_i",
      "note": "32-bit pulse count snapshot, 1-second interval"
    },
    {
      "from": "peripheral.pwm_out",
      "to": "external.pwm_in",
      "note": "3.3V logic to compatible driver/isolated interface, not motor power"
    },
    {
      "from": "external.tach_out",
      "to": "peripheral.tach_in",
      "note": "3.3V conditioned tach input; 2-FF synchronizer"
    }
  ],
  "source_files": [
    "rtl/smart_fan_peripheral.v",
    "tb/tb_smart_fan_peripheral.v",
    "sw/fan_mmio.c",
    "INTEGRATION.md"
  ],
  "bom": [
    {
      "part": "Digilent Basys3",
      "quantity": "1",
      "interface": "100MHz clock / 3.3V I/O",
      "notes": "실제 핀은 XDC 검증 후 배정"
    },
    {
      "part": "3.3V-compatible external PWM driver / fan interface",
      "quantity": "1",
      "interface": "PWM output",
      "notes": "12V 모터/팬 직접 연결 금지"
    },
    {
      "part": "3.3V-conditioned tach output or logic pulse generator",
      "quantity": "1",
      "interface": "tach input",
      "notes": "5V/12V 신호 직접 연결 금지"
    },
    {
      "part": "External motor/fan power supply",
      "quantity": "as required",
      "interface": "external",
      "notes": "FPGA I/O 전원과 별도, 접지·절연 설계 확인"
    }
  ],
  "verification_notice": "독립 RTL 및 테스트벤치 제공. AXI Block Design, XDC 핀 확정, 합성·구현·Timing·실제 팬 제어 테스트는 수행되지 않았습니다. verification.json에 실제 실행 결과만 기록합니다.",
  "safety_notice": "Basys3 I/O는 3.3V입니다. 팬/모터 전원·타코 신호를 직접 연결하지 마세요. 드라이버 전압·전류·절연·공통 접지 및 팬 인터페이스 규격을 검증하십시오.",
  "provenance": "이 저장소에서 새로 작성한 독립 RTL 교육 예제. 타사 공개 소스를 복제하지 않았습니다."
}
